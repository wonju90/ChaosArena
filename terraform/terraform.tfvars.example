# 이 파일을 terraform.tfvars로 복사한 뒤 실제 값을 채우세요.
# terraform.tfvars는 .gitignore에 등록되어 있어 커밋되지 않습니다.

# nhncloud_user_id / tenant_id / password 는 모두
# Compute > Instance > Management > "API 엔드포인트 설정" 화면에서 확인
# (user_id는 'API 사용자 ID' 값이며, 콘솔 로그인 이메일이 아님)
nhncloud_user_id  = "REPLACE_WITH_API_USER_ID"
nhncloud_tenant_id = "REPLACE_WITH_TENANT_ID"
nhncloud_password  = "REPLACE_WITH_API_PASSWORD"

# SSH 공개키는 RSA만 지원 (ed25519는 NHN Cloud가 거부). ssh-keygen -t rsa -b 4096 로 생성.
ssh_public_key = "ssh-rsa AAAA... your-public-key"
admin_cidr     = "203.0.113.4/32" # 본인 접속 IP/32

# vpc_id / subnet_id 는 콘솔 Network > VPC / Subnet 에서 확인.
# 인터넷 게이트웨이가 연결된 기존 VPC(보통 'Default Network')와 그 안의 서브넷을 지정한다.
kr1_vpc_id      = "REPLACE_WITH_KR1_VPC_ID"
kr1_subnet_id   = "REPLACE_WITH_KR1_SUBNET_ID"
kr1_image_name  = "Ubuntu Server 22.04.5 LTS (2026.03.10)"
kr1_flavor_name = "r2.c4m16"

kr2_vpc_id      = "REPLACE_WITH_KR2_VPC_ID"
kr2_subnet_id   = "REPLACE_WITH_KR2_SUBNET_ID"
kr2_image_name  = "Ubuntu Server 22.04.5 LTS (2026.03.10)"
kr2_flavor_name = "r2.c4m16"
